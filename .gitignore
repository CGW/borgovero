__pycache__/
*.pyc
.DS_Store
cache/
# data/ is regenerable EXCEPT the ID anchors, which are hours of Wayback
# harvesting that cannot be reconstructed if archive.org access changes.
# Note: `data/*` rather than `data/` — git will not descend into an ignored
# directory, so the negation below only works if the contents are ignored
# rather than the directory itself.
**/data/*
!**/data/id_anchors.json
# Small, human-measured, not regenerable by code — the same reasoning as
# id_anchors.json, and they were only ignored because they happened to
# live in the same directory as the big AdE downloads. On 2026-08-29
# phase0/data/ was deleted whole; id_anchors.json came back from git in
# one command and everything else in there did not. A few KB of hand
# readings should never share a fate with a 30 MB zip.
!**/data/surface_reads.md
!**/data/surface_sample.md
!**/data/*.json
*.sqlite
*.sqlite-journal
phase0_results.csv
phase0/fairprice.csv
dist/
# Generated site output — regenerable from the database in seconds.
dist-contradictions/
dist-index/
# S004's corrected DB, delivered as text because the sandbox mount
# corrupts live sqlite writes. ~2 MB and regenerable from the harvests;
# keep it out of the repo but DO keep it on disk until it is applied.
phase0/phase0_S004_restore.sql
phase0/phase0_restore.sql
phase0/*.sqlite.corrupt
phase0/*.sqlite.pre-S004
